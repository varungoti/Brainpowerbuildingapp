# Copy to android/keystore.properties (never commit the real file).
# Generate upload keystore once:
#   keytool -genkey -v -keystore neurospark-upload.keystore -alias neurospark -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile path is relative to android/ directory.

storeFile=neurospark-upload.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=neurospark
keyPassword=YOUR_KEY_PASSWORD
