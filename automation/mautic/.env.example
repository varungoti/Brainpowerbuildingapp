MAUTIC_BASE_URL=https://mautic.example.com
MAUTIC_DB_HOST=mautic-db
MAUTIC_DB_NAME=mautic
MAUTIC_DB_USER=mautic
MAUTIC_DB_PASSWORD=change-me
MAUTIC_ADMIN_EMAIL=admin@example.com
MAUTIC_ADMIN_PASSWORD=change-me
MAUTIC_API_USER=api-user
MAUTIC_API_PASSWORD=change-me

# Email must stay disabled until SPF/DKIM/DMARC, unsubscribe, sender identity,
# and Growth Command Center approval gates are verified.
MAUTIC_MAILER_DSN=null://null
MAUTIC_EMAIL_SEND_ENABLED=false

# NeuroSpark guardrails.
NS_GROWTH_DRY_RUN=true
NS_GROWTH_REQUIRE_APPROVAL=true
NS_GROWTH_SUPPRESSION_REQUIRED=true
NS_GROWTH_WEBHOOK_SECRET=change-me
NS_ADMIN_API_BASE=https://your-edge-function.example.com
