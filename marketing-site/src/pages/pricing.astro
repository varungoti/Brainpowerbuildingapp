---
import Site from "../layouts/Site.astro";
import Reveal from "../components/Reveal.astro";

const tiers = [
  { id: "starter", name: "Starter", price: "Free", desc: "Preview daily activities, the brain map, and sample printable guidance.", cta: "Download free", features: ["Limited daily pack", "Brain map preview", "Printable samples", "Trust and science guide"] },
  { id: "family", name: "Family Premium", price: "$9.99 / mo", desc: "The main global family subscription for daily practice.", cta: "Start Premium", features: ["Full daily packs", "AI Counselor and coach", "Printable parent guides", "Weekly reports", "Audio mode", "Caregiver sharing"] },
  { id: "annual", name: "Annual launch", price: "$79 / yr", desc: "Annual-first launch offer aligned with the in-app premium plan.", cta: "Get annual", features: ["Everything in Premium", "Best annual value", "Launch bonuses", "Priority new features"] },
  { id: "pro", name: "Family Pro", price: "$199-$499 / yr", desc: "For parents who want deeper reports, printables, and guided support.", cta: "Join Pro waitlist", features: ["Printable curriculum packs", "Pediatrician snapshots", "Long-memory coach", "Workshops and premium bundles"] },
  { id: "partner", name: "Partner pilot", price: "$2.5k-$10k pilot", desc: "For preschools, clinics, homeschool groups, creators, and employers.", cta: "Book partner demo", features: ["Bulk access", "Take-home guides", "Partner reporting", "Creator/clinic/employer packages"] },
];
---
<Site title="Pricing" description="Global Family Premium $9.99/mo or $79/yr, Family Pro, and partner pilots for schools, clinics, creators, and employers.">
  <section class="container-tight py-24">
    <Reveal>
      <span class="pill">Pricing</span>
      <h1 class="mt-4 text-5xl max-w-2xl">Launch pricing built for families and serious partners.</h1>
      <p class="mt-4 text-ink/70 max-w-2xl">Consumer pricing is annual-first for momentum. Partner pilots create the high-ticket revenue path needed for the $10M growth goal.</p>
    </Reveal>

    <div class="mt-14 grid md:grid-cols-2 xl:grid-cols-5 gap-6">
      {tiers.map((t, i) => (
        <Reveal delay={i * 0.1}>
          <article class:list={["rounded-3xl p-8 border h-full", t.id === "annual" ? "bg-ink text-white border-ink" : "bg-white border-ink/5"]}>
            <h2 class="text-2xl font-extrabold">{t.name}</h2>
            <div class="text-4xl font-display font-extrabold mt-2">{t.price}</div>
            <p class:list={["mt-2 text-sm", t.id === "annual" ? "text-white/70" : "text-ink/70"]}>{t.desc}</p>
            <ul class:list={["mt-6 space-y-2 text-sm", t.id === "annual" ? "text-white/90" : "text-ink/80"]}>
              {t.features.map((f) => <li>· {f}</li>)}
            </ul>
            <a href={t.id === "partner" ? "/download?intent=partner-demo" : `/download?plan=${t.id}`} class:list={["mt-8 inline-flex w-full justify-center", t.id === "annual" ? "btn-primary" : "btn-ghost"]}>{t.cta}</a>
          </article>
        </Reveal>
      ))}
    </div>

    <Reveal delay={0.4}>
      <p class="mt-10 text-sm text-ink/60 max-w-2xl">India launch pricing is localized in-app around ₹4,999-₹7,999/year for annual family plans. Education and accessibility families: <a href="mailto:hello@neurospark.com" class="underline">hello@neurospark.com</a>. We offer scholarships for families who need them.</p>
    </Reveal>
  </section>
</Site>
